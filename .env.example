# GitHub user whose public repos make up the portfolio.
GITHUB_USERNAME=nickprignano

# Optional: a token (no scopes needed for public repos) raises the API rate
# limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: comma-separated repo names to hide from the portfolio.
PORTFOLIO_EXCLUDE=

# Optional: set to "true" to include forked repos.
PORTFOLIO_INCLUDE_FORKS=false

# Optional: max projects shown (each needs one README request).
PORTFOLIO_LIMIT=24
