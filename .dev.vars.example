# Local secrets for `npm run preview` / `next dev`. Copy to .dev.vars.
GITHUB_TOKEN=
# Contact form. These are Cloudflare's public always-pass Turnstile test keys;
# the real secret goes in the Cloudflare dashboard, never here.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Where local test messages go (local dev only simulates sending).
CONTACT_TO=you@example.com
