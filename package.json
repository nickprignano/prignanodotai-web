{
  "name": "prignanodotai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"lib/**/*.test.ts\"",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "OPEN_NEXT_DEPLOY=true wrangler deploy && opennextjs-cloudflare populateCache remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "^16.3.6",
    "prignano-theme": "https://codeload.github.com/nickprignano/prignano-theme/tar.gz/845aaf349d33233df0520996c172804596df7ec9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  }
}
